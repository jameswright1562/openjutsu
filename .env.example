# Local ComfyUI behind comfy-api-proxy (no key needed).
COMFY_BASE_URL=http://127.0.0.1:8189
# Only for a Comfy Developer Platform deployment or Comfy Cloud.
COMFY_API_KEY=
# ComfyUI itself (not the proxy), only to fill the base model and LoRA pickers. Leave empty for 127.0.0.1:8188.
COMFYUI_URL=
# Required before hosting or tunneling the app. Browser login: username openjutsu. Use HTTPS remotely.
OPENJUTSU_PASSWORD=

# Experimental two-machine workflow splitting (From Picture only).
# Run OpenJutsu and the default ComfyUI instance on your Windows desktop.
# Direct ComfyUI endpoint on the Windows laptop, reachable over a trusted LAN/Tailscale.
# Example: http://192.168.1.100:8188 (replace with your actual laptop address).
OPENJUTSU_LAPTOP_COMFYUI_URL=
# Initial selection for the From Picture video render worker. The UI can override this.
OPENJUTSU_PICTURE_RENDER_BACKEND=desktop
